<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="AWS Meter Reading Flow Ready">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- External Services -->
        <mxCell id="Twilio" value="Twilio WhatsApp API" style="shape=mxgraph.aws.general.icon;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="120" height="80" as="geometry"/>
        </mxCell>

        <!-- AWS Cloud -->
        <mxCell id="AWS" value="AWS Cloud" style="rounded=1;fillColor=#FF9900;strokeColor=#D97706;strokeWidth=2;fontColor=#ffffff;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="850" height="600" as="geometry"/>
        </mxCell>

        <!-- Serverless -->
        <mxCell id="Serverless" value="Serverless" style="rounded=1;fillColor=#1E90FF;strokeColor=#104E8B;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="AWS">
          <mxGeometry x="20" y="20" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="APIGW" value="API Gateway" style="shape=mxgraph.aws.integration.api_gateway;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Serverless">
          <mxGeometry x="20" y="20" width="80" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="Lambda" value="Lambda Function (OCR + User Confirmation)" style="shape=mxgraph.aws.compute.lambda;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Serverless">
          <mxGeometry x="120" y="20" width="150" height="80" as="geometry"/>
        </mxCell>

        <!-- Storage -->
        <mxCell id="Storage" value="Storage" style="rounded=1;fillColor=#00C49A;strokeColor=#01796F;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="AWS">
          <mxGeometry x="350" y="20" width="220" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="S3" value="S3 Bucket" style="shape=mxgraph.aws.storage.s3_bucket;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Storage">
          <mxGeometry x="20" y="20" width="80" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="Outbox" value="Outbox Table DynamoDB" style="shape=mxgraph.aws.database.dynamodb;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Storage">
          <mxGeometry x="120" y="20" width="80" height="80" as="geometry"/>
        </mxCell>

        <!-- Compute -->
        <mxCell id="Compute" value="Compute" style="rounded=1;fillColor=#512BD4;strokeColor=#3A1F8F;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="AWS">
          <mxGeometry x="20" y="180" width="500" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="RabbitMQ" value="RabbitMQ Cluster ECS Fargate" style="shape=mxgraph.aws.compute.ecs;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Compute">
          <mxGeometry x="20" y="20" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ECSBilling" value="Billing Service ECS Fargate" style="shape=mxgraph.aws.compute.ecs;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Compute">
          <mxGeometry x="180" y="20" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="RDS" value="PostgreSQL RDS" style="shape=mxgraph.aws.database.rds;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Compute">
          <mxGeometry x="340" y="20" width="120" height="80" as="geometry"/>
        </mxCell>

        <!-- Monitoring -->
        <mxCell id="Monitoring" value="Monitoring" style="rounded=1;fillColor=#FFA500;strokeColor=#FF8C00;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="AWS">
          <mxGeometry x="550" y="180" width="250" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="CloudWatch" value="CloudWatch Logs" style="shape=mxgraph.aws.management.cloudwatch;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Monitoring">
          <mxGeometry x="20" y="20" width="80" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="Alarms" value="CloudWatch Alarms" style="shape=mxgraph.aws.management.cloudwatch;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="Monitoring">
          <mxGeometry x="120" y="20" width="80" height="80" as="geometry"/>
        </mxCell>

        <!-- EventBridge -->
        <mxCell id="EventBridge" value="EventBridge Retry Outbox" style="shape=mxgraph.aws.integration.eventbridge;html=1;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="AWS">
          <mxGeometry x="580" y="50" width="150" height="80" as="geometry"/>
        </mxCell>

        <!-- Connections -->
        <mxCell id="e1" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#1E90FF;strokeWidth=3;" edge="1" source="Lambda" target="Outbox" parent="1"/>
        <mxCell id="e2" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#1E90FF;strokeWidth=3;" edge="1" source="Outbox" target="EventBridge" parent="1"/>
        <mxCell id="e3" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#1E90FF;strokeWidth=3;" edge="1" source="EventBridge" target="RabbitMQ" parent="1"/>
        <mxCell id="e4" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#1E90FF;strokeWidth=3;" edge="1" source="RabbitMQ" target="ECSBilling" parent="1"/>
        
        <mxCell id="e5" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#000000;" edge="1" source="Twilio" target="APIGW" parent="1"/>
        <mxCell id="e6" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#000000;" edge="1" source="APIGW" target="Lambda" parent="1"/>
        <mxCell id="e7" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#000000;" edge="1" source="Lambda" target="S3" parent="1"/>
        <mxCell id="e8" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#000000;" edge="1" source="Lambda" target="CloudWatch" parent="1"/>
        <mxCell id="e9" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#000000;" edge="1" source="ECSBilling" target="RDS" parent="1"/>
        <mxCell id="e10" style="edgeStyle=elbowEdgeStyle;rounded=1;endArrow=block;strokeColor=#000000;" edge="1" source="ECSBilling" target="Alarms" parent="1"/>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
